# Optional: enable Qwen only after providing all values below.
QWEN_VISION_FALLBACK_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
QWEN_TIMEOUT_SECONDS=30
QWEN_FALLBACK_CONFIDENCE=0.85

# PaddleOCR-VL-1.6 is the default primary engine. Use paddleocr_legacy to roll back.
OCR_ENGINE=paddleocr_vl
PADDLEOCR_VL_DEVICE=cpu
PADDLEOCR_VL_PIPELINE_VERSION=v1.6

# Quality routing and upload guardrails. For PaddleOCR-VL, confidence is a
# compatibility quality score based on layout detection, not text probability.
OCR_CONFIDENCE_THRESHOLD=0.80
MAX_IMAGE_BYTES=10485760

# 模型源：bos（百度）默认；若 bos 下载慢或卡住，可换 modelscope（阿里）或 huggingface。
PADDLE_PDX_MODEL_SOURCE=modelscope
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# 模型缓存目录：建议放到非系统盘（避免 C 盘空间不足）。
PADDLE_PDX_CACHE_HOME=D:\PaddleOCRCache
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False

# PaddleOCR-VL already recognizes formulas. Pix2Text is a legacy-only optional
# enhancement and is skipped automatically when PaddleOCR-VL returns Markdown.
PIX2TEXT_ENABLED=false
PIX2TEXT_DEVICE=cpu
